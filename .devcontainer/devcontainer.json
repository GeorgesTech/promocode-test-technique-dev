{
    "name": "Indy Promocode Workshop",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "features": {
      "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },
    "hostRequirements": {
      "cpus": 4,
      "memory": "16gb",
      "storage": "32gb"
    },
    "forwardPorts": [3000],
    "portsAttributes": {
      "3000": {
        "label": "Promocode API",
        "onAutoForward": "notify",
        "visibility": "private"
      }
    },
    "remoteEnv": {
      "PORT": "3000"
    },
    "updateContentCommand": "npm ci && npm test",
    "customizations": {
      "vscode": {
        "extensions": ["vitest.explorer"]
      }
    }
  }
  